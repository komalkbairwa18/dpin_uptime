generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(uuid()) 
  email String
}

model Website {
  id      String        @id @default(uuid())
  url     String
  userId  String
  ticks   WebsiteTick[]
}

model Validator {
  id        String         @id @default(uuid())
  publicKey String
  location  String          // fixed typo here
  ip        String
  ticks     WebsiteTick[]   // changed from single to array
}

model WebsiteTick {
  id          String         @id @default(uuid())
  websiteId   String      
  validatorId String?
  createdAt   DateTime
  status      WebsiteStatus
  latency     Float

  website     Website    @relation(fields: [websiteId], references: [id])
  validator   Validator? @relation(fields: [validatorId], references: [id])
}

enum WebsiteStatus {
  Good
  Bad
}
